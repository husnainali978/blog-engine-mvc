@model Post
@{
    ViewData["Title"] = "Delete Post";
}

<h1 class="h3 mb-4">Delete post</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this post? This also removes its comments and cannot be undone.
</div>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Author</dt>
    <dd class="col-sm-10">@Model.Author</dd>

    <dt class="col-sm-2">Tags</dt>
    <dd class="col-sm-10">
        @if (Model.Tags.Any())
        {
            @string.Join(", ", Model.Tags.OrderBy(t => t.Name).Select(t => t.Name))
        }
        else
        {
            <span class="text-muted">none</span>
        }
    </dd>

    <dt class="col-sm-2">Created</dt>
    <dd class="col-sm-10">@Model.CreatedAtUtc.ToString("MMMM d, yyyy")</dd>
</dl>

<form asp-controller="Admin" asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete permanently</button>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-link">Cancel</a>
</form>
