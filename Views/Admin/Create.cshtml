@model PostFormViewModel
@{
    ViewData["Title"] = "New Post";
}

<h1 class="h3 mb-4">New post</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-controller="Admin" asp-action="Create" method="post">
            @await Html.PartialAsync("_PostFormFields", Model)
            <button type="submit" class="btn btn-primary">Create post</button>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
