@model HomeIndexViewModel
@{
    ViewData["Title"] = Model.ActiveTagName is not null ? $"Posts tagged \"{Model.ActiveTagName}\"" : "Posts";
}

<div class="row">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-baseline mb-4">
            <h1 class="h3 mb-0">
                @if (Model.ActiveTagName is not null)
                {
                    <span>Posts tagged &ldquo;@Model.ActiveTagName&rdquo;</span>
                }
                else
                {
                    <span>Latest posts</span>
                }
            </h1>
            @if (Model.ActiveTagSlug is not null)
            {
                <a asp-controller="Home" asp-action="Index" class="small">Clear filter &times;</a>
            }
        </div>

        @if (!Model.Posts.Any())
        {
            <p class="text-muted">No posts here yet.</p>
        }

        @foreach (var post in Model.Posts)
        {
            <article class="mb-4 pb-4 border-bottom">
                <h2 class="h4 mb-1">
                    <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" asp-route-slug="@post.Slug"
                       class="text-decoration-none">@post.Title</a>
                </h2>
                <div class="text-muted small mb-2">
                    by @post.Author &middot; @post.CreatedAtUtc.ToString("MMMM d, yyyy")
                    @if (post.Comments.Any())
                    {
                        <span>&middot; @post.Comments.Count comment@(post.Comments.Count == 1 ? "" : "s")</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(post.Summary))
                {
                    <p class="mb-2">@post.Summary</p>
                }
                <div class="mb-2">
                    @foreach (var tag in post.Tags.OrderBy(t => t.Name))
                    {
                        <a asp-controller="Home" asp-action="Index" asp-route-tag="@tag.Slug"
                           class="badge text-bg-light border text-decoration-none me-1">@tag.Name</a>
                    }
                </div>
                <a asp-controller="Posts" asp-action="Details" asp-route-id="@post.Id" asp-route-slug="@post.Slug"
                   class="small">Read more &rarr;</a>
            </article>
        }
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 card-title text-uppercase text-muted">Browse by tag</h2>
                <ul class="list-unstyled mb-0">
                    <li class="mb-1">
                        <a asp-controller="Home" asp-action="Index"
                           class="text-decoration-none @(Model.ActiveTagSlug is null ? "fw-semibold" : "")">
                            All posts
                        </a>
                    </li>
                    @foreach (var tag in Model.Tags)
                    {
                        <li class="mb-1">
                            <a asp-controller="Home" asp-action="Index" asp-route-tag="@tag.Slug"
                               class="text-decoration-none @(tag.Slug == Model.ActiveTagSlug ? "fw-semibold" : "")">
                                @tag.Name
                            </a>
                            <span class="text-muted small">(@tag.PostCount)</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
